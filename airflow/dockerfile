# 1. เริ่มจาก Image หลัก
FROM apache/airflow:3.1.3

# 2. เปลี่ยนเป็น root เพื่อลงโปรแกรม
USER root

# 3. อัปเดตและลง Xvfb และโปรแกรมพื้นฐาน
# (ลบ library ที่ error ออก แล้วลงแค่ตัวที่จำเป็นจริงๆ)
RUN apt-get update && apt-get install -y \
    xvfb \
    wget \
    gnupg \
    unzip \
    && apt-get clean

# 4. ติดตั้ง Google Chrome (วิธีนี้ดีที่สุด)
# โหลดไฟล์ .deb มา แล้วสั่ง install ไฟล์นั้น ระบบจะไปหา dependencies ที่ขาด (เช่น libgtk, libnss, etc.) มาลงให้เองอัตโนมัติ
RUN wget -q https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb \
    && apt-get install -y ./google-chrome-stable_current_amd64.deb \
    && rm google-chrome-stable_current_amd64.deb

# 5. สลับกลับมาเป็น user airflow
USER airflow

# 6. ลง Python Library ที่ต้องใช้
RUN pip install --no-cache-dir \
    pandas \
    beautifulsoup4 \
    selenium \
    undetected-chromedriver \
    pyvirtualdisplay