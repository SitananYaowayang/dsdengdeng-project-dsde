# ===========================
# 1. Data & System Files (ของเดิม)
# ===========================
data/
*.csv
*.xlsx
*.json

# Ignore System Files
__pycache__/
*.pyc
.DS_Store

# ===========================
# 2. Environment & Secrets (สำคัญมาก)
# ===========================
venv/
env/
.env
credentials.json
dags/credentials.json

# Ignore IDE settings
.vscode/
.idea/

# ===========================
# 3. Docker & Airflow (ส่วนที่เพิ่ม)
# ===========================

# Ignore Airflow Logs (ไฟล์ Log ที่ Docker สร้างมาเยอะๆ ไม่เอา)
airflow/logs/
logs/

# Ignore Airflow PID/State files (ไฟล์สถานะการทำงาน)
airflow-webserver.pid
airflow.db
airflow.cfg

# Ignore Database Data (ถ้ามีการ Map Volume ออกมาเก็บข้อมูล DB)
postgres_data/
pg_data/
mysql_data/

# ===========================
# 4. Whitelist (บังคับให้เก็บไฟล์พวกนี้)
# ===========================
# ! หมายถึง "ห้าม ignore" (เก็บไว้)

# เก็บ Docker config
!docker-compose.yaml
!dockerfile
!Dockerfile

# เก็บ DAGs ทั้งหมด
!airflow/dags/
!dags/

# เก็บ Plugins (เผื่อมีโค้ด Python เสริม)
!airflow/plugins/